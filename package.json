{
  "name": "freakshow-projection",
  "version": "5.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/serve.js",
    "build": "node scripts/build.js",
    "preview": "node scripts/serve.js dist",
    "test": "node --test tests/engine.test.js tests/rig.test.js tests/character.test.js",
    "test:browser": "npm run build && node tests/browser.js",
    "check-session": "node scripts/check-session.js",
    "format": "prettier --write index.html styles.css src scripts tests README.md package.json manifest.webmanifest sw.js",
    "test:integration": "npm run build && node tests/integration-browser.js",
    "test:mobile": "npm run build && node tests/mobile-character-browser.js",
    "test:rig": "npm run build && node tests/rig-browser.js",
    "test:pages": "PAGES_BASE=/freakshow-projection/ npm run build && node tests/pages-browser.js",
    "sculpt:bake": "node scripts/bake-character-sculpt.js",
    "sculpt:check": "node scripts/check-character-sculpt-cache.js",
    "test:sculpt": "npm run build && node tests/carved-curls-browser.js"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "manifold-3d": "^3.5.4",
    "meshoptimizer": "^1.0.1",
    "playwright": "1.58.2",
    "prettier": "3.6.2"
  }
}
